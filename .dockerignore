.cache/
.pytest_cache/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/

# Git files
.git/
.gitignore

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Python virtual environments
venv/
.venv/
env/
.env

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Model checkpoints and weights (if any)
*.pt
*.pth
*.ckpt
*.safetensors

# Log files
*.log
logs/

# Temporary files
tmp/
temp/
