{
  "architecture": "standard",
  "hidden_size": 256,
  "heads": 4,
  "layers": 6,
  "batch_size": 16,
  "grad_accum": 1,
  "optimizer": "muon",
  "learning_rate": 0.0003,
  "muon_lr": 0.02,
  "weight_decay": 0.01,
  "muon_backend": "newton_schulz",
  "momentum_warmup_fraction": 0.05,
  "lr_schedule": "warmup_cosine",
  "warmup_fraction": 0.05,
  "cooldown_fraction": 0.5,
  "min_lr_ratio": 0.1,
  "fused_adam": true,
  "prefetch": true,
  "fused_qkv": true,
  "attention_backend": "sdpa",
  "value_embeddings": true,
  "embedding_residual": true,
  "value_embedding_gate": false,
  "compile": false,
  "bf16": true,
  "seed": 42
}
